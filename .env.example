# ------------------------------------------------------------------------------
# OxySense Environment Configuration (.env.example)
# ------------------------------------------------------------------------------

# Optional: Groq Cloud LLM API Key for advanced AI Insights (e.g. Llama-3.3-70B)
# When omitted, OxySense runs offline deterministic clinical rules.
# Get a free key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# Server Port (default: 5000)
PORT=5000

# Operational Environment: "development" or "production"
FLASK_ENV=development
